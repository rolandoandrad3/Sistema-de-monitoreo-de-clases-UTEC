@{
    ViewBag.Title = "Home Page";
}


<main>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Style.css" rel="stylesheet" />
    <section class="row" aria-labelledby="aspnetTitle">
        <div class="container py-4">
            <!-- Encabezado de la página con título y botones de acción -->
            <div class="row align-items-center mb-4">
                <div class="col-12 col-md-6 mb-3 mb-md-0">
                    <h1 class="h3 mb-0">Panel de Monitoreo</h1>
                </div>
                <div class="col-12 col-md-6">
                    <!-- Botones de exportación y nuevo monitoreo -->
                    <div class="d-flex flex-column flex-md-row justify-content-md-end gap-2">
                        <button class="btn btn-outline-primary w-100 w-md-auto mb-2 mb-md-0">
                            <i class="fas fa-file-export me-2"></i>Exportar Reporte
                        </button>
                        <button class="btn btn-primary w-100 w-md-auto">
                            <i class="fas fa-plus me-2"></i>Nuevo Monitoreo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section>
        <!-- Contenido principal con tabla de sistemas y reportes recientes -->
        <div class="row g-4">
            <!-- Tabla de Sistemas Monitoreados -->
            <div class="col-12 col-xl-6">
                <div class="status-card p-4">
                    <h2 class="h5 mb-4">Facultades Monitoreadas</h2>
                    <!-- Tabla interactiva con estado de sistemas -->
                    <div class="table-responsive">
                        <table class="table table-hover">
                            ...
                        </table>
                    </div>
                </div>
            </div>

            <!-- Sección de Reportes Recientes -->
            <div class="col-12 col-xl-6">
                <div class="status-card p-4">
                    <h2 class="h5 mb-4">Reportes Recientes</h2>
                    <!-- Lista de reportes descargables -->
                    <div class="d-flex flex-column gap-3">
                        ...
                    </div>
                </div>
            </div>
        </div>
    </section>


</main>